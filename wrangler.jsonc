{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rackline",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://rackline.brian-72c.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rackline",
      "database_id": "8c92d366-90f5-4743-bc2f-7888ab3c1405",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "rackline-media"
    }
  ]
}
